# ============================================================
# Home Assistant OS  Wi-Fi設定ファイル (my-network)
#
# 1. 下の ssid= と psk= を書き換えてください
# 2. IPアドレスは標準で「自動取得(DHCP)」です
#    → ブラウザで http://homeassistant.local を開きます
# 3. 固定IPにしたい場合は [ipv4] の説明に従ってください
#
# ※ # で始まる行はコメント（無視されます）
# ※ ファイル名は拡張子なしの my-network のままにしてください
# ============================================================

[connection]
id=my-network
uuid=5f3c2a8e-9b41-4d7a-a6e2-3c81f0d4b927
type=802-11-wireless

[802-11-wireless]
mode=infrastructure
ssid=ここにSSID
# SSIDが非公開(ステルス)の場合は、次の行の # を外す
#hidden=true

[802-11-wireless-security]
auth-alg=open
key-mgmt=wpa-psk
psk=ここにパスワード

[ipv4]
# ---- 標準：自動取得(DHCP) ----
method=auto

# ---- 固定IPにする場合 ----
# (1) 上の method=auto の行頭に # を付けて無効にする
# (2) 下の3行の先頭の # を外し、値を自分のネットワークに合わせる
#     address1=PiのIPアドレス/プレフィックス長,ゲートウェイ
#     dns=DNSサーバー;DNSサーバー;   (最後にも ; が必要)
#method=manual
#address1=192.168.1.50/24,192.168.1.1
#dns=192.168.1.1;1.1.1.1;

[ipv6]
addr-gen-mode=stable-privacy
method=auto
